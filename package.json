{
  "name": "year-end-gala",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "1000-person live gala games: lottery, shake, red packet rain and quiz.",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "postbuild": "node scripts/precompress.mjs",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test server/tests/*.test.ts",
    "test:ui": "node scripts/ui-smoke.mjs",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "loadtest": "tsx scripts/loadtest.ts",
    "stress-game": "tsx scripts/stress-game.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.23",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.1",
    "playwright": "^1.65.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
